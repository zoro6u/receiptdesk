# Copy to .env and adjust. Real environment variables override this file.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Default: sqlite:///<project>/data/receiptdesk.db
# DATABASE_URL=sqlite:///./data/receiptdesk.db
# DATA_DIR=./data
MAX_UPLOAD_MB=10
# Seconds to wait for the model (the first request loads it; on CPU-only machines this can take minutes)
OLLAMA_TIMEOUT_S=600
# How long Ollama keeps the model in memory after a request (avoids slow reloads). e.g. 30m, 2h, -1 = forever
OLLAMA_KEEP_ALIVE=30m
MAX_PDF_PAGES=5
# Tesseract language codes, joined with +, e.g. eng+fra (each needs its language pack installed)
OCR_LANGUAGES=eng
MAX_TEXT_CHARS=20000
# GPU layers for Ollama. Leave unset to let Ollama decide. 0 forces CPU only: use it if a small or old GPU
# (e.g. 2 GB VRAM) makes requests hang or crawl.
# OLLAMA_NUM_GPU=0
